#!/usr/bin/env bash
#
# dotfiles-update
#
# `dotfiles-update` handles updating the dotfiles themselves, as well as installing and updating all dependencies. 
# Run it periodically to make sure you're on the latest and greatest.

set -e

parentDirectory="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P)"
dotfilesDirectory="$(cd "$( dirname "$parentDirectory" )" && pwd -P)"

displayUsage() {
	echo "dotfiles-update -- dotfiles management"
	echo ""
	echo "Usage: dotfiles-update [options]"
	echo ""
	echo "Options:"
	echo "  -e, --edit    Open dotfiles directory for editing"
	echo "  -h, --help    Show this help message and exit"
}

# Parse command line arguments
while test $# -gt 0; do
	case "$1" in
		"-h"|"--help")
			displayUsage
			exit 0
			;;
		"-e"|"--edit")
			# Unquoted, so an EDITOR with arguments (e.g. `code --wait`) is split into command and args
			exec ${EDITOR:-nano} "$dotfilesDirectory"
			exit
			;;
		*)
			echo "Invalid option: $1"
			displayUsage
			exit 1
			;;
	esac
	shift
done

export DOTFILES="$dotfilesDirectory"

# Output formatting helpers: info, success, warn, error
. "$DOTFILES/script/output_format"

# Update dotfiles themselves. Not fatal: local changes or a missing upstream shouldn't block installing software.
info "Updating dotfiles..."
info "› git pull"
git -C "$DOTFILES" pull --ff-only || warn "Couldn't pull the latest dotfiles, continuing with the local copy"

# On macOS, install and upgrade Homebrew and everything it installed.
# On Linux, apt packages aren't upgraded here: that's the system's job (`sudo apt upgrade`, and
# unattended-upgrades, which Ubuntu runs for security updates). script/install only adds missing ones.
if [ "$(uname -s)" = Darwin ]
then
  # Install homebrew
  "$DOTFILES/homebrew/bootstrap"

  # Add Homebrew to PATH (bootstrap runs in its own process, so it doesn't affect this script's PATH)
  . "$DOTFILES/homebrew/path.sh"

  # Upgrade homebrew
  info "› brew update"
  brew update

  info "› brew upgrade"
  brew upgrade
fi

# Install software
info "› script/install"
"$DOTFILES/script/install"
