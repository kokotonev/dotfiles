#!/usr/bin/env bash
#
# Installs the system packages (Brewfile on macOS, Aptfile on Linux), then runs all topic installers.

set -e

cd "$(dirname $0)"/..

# The topic installers use it to find the repo, e.g. for script/output_format
export DOTFILES="$(pwd -P)"

# Output formatting helpers: info, success, warn, error
. script/output_format

install_brew_packages () {
  if ! command -v brew >/dev/null 2>&1
  then
    error "Homebrew isn't installed. Run homebrew/bootstrap (or bin/dotfiles-update) first."
  fi

  info "Installing dependencies from Brewfile..."
  info "› brew bundle"
  # Not fatal: e.g. a cask whose app is already in /Applications fails, but everything else still installs
  brew bundle || warn "Some Brewfile entries failed to install (see above), continuing"

  link_keg_only
}

# Keg-only formulae aren't linked into PATH by default, so link the ones we want
link_keg_only () {
  for formula in $(brew list --formula -1 | grep '^postgresql@')
  do
    # Homebrew keeps a symlink here for every linked keg, so skip the ones already linked
    [ -L "$(brew --prefix)/var/homebrew/linked/$formula" ] && continue
    info "› brew link $formula"
    brew link --force "$formula" || warn "Couldn't link $formula"
  done
}

install_apt_packages () {
  if ! command -v apt-get >/dev/null 2>&1
  then
    warn "No apt-get on this system, skipping the Aptfile"
    return
  fi

  # Find the Aptfile packages that aren't installed yet. Checking needs no sudo, so when nothing is
  # missing (e.g. on a routine dotfiles-update), nothing asks for your password.
  local pkg missing=()
  for pkg in $(sed 's/#.*//' Aptfile)
  do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'ok installed' || missing+=("$pkg")
  done

  if [ ${#missing[@]} -eq 0 ]
  then
    success "All Aptfile packages are installed"
    return
  fi

  info "Installing from Aptfile: ${missing[*]}"
  info "› sudo apt-get update"
  if ! sudo apt-get update -qq
  then
    warn "Couldn't run apt-get with sudo, skipping the Aptfile"
    return
  fi

  # One at a time, so a package this release doesn't have doesn't stop the others.
  # DEBIAN_FRONTEND=noninteractive stops packages from stopping to ask questions (e.g. tzdata).
  for pkg in "${missing[@]}"
  do
    info "› sudo apt-get install $pkg"
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$pkg" || warn "Couldn't install $pkg, skipping"
  done
}

case "$(uname -s)" in
  Darwin) install_brew_packages ;;
  Linux) install_apt_packages ;;
esac

# find the installers and run them iteratively. One that fails doesn't stop the others.
info "Running topic installers..."
find . -name install.sh | while read installer
do
  info "› ${installer#./}"
  sh -c "${installer}" || warn "${installer#./} failed, continuing"
done
