alias gf="git fetch --all --prune"
alias gp="git pull"
alias glog="git log --graph --pretty=format:'%Cred%h%Creset %an: %s - %Creset %C(yellow)%d%Creset %Cgreen(%cr)%Creset' --abbrev-commit"

alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gcm="git commit -m"
alias gco="git checkout"
alias gun="git restore --staged"

alias greb="git rebase"
alias grebc="git rebase --continue"
alias grab="git rebase --abort"

